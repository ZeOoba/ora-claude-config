# secrets.env.example -- template for ~/.config/ora/ora.env (mode 600).
# provision.sh copies this file there (replacing /home/YOURUSER with the real
# home dir) if ora.env does not exist yet. NEVER put the real file inside the
# ~/.claude git checkout; it lives at ~/.config/ora/ora.env only.
#
# FORMAT RULES (this file is read BOTH by bash 'source' AND by systemd
# EnvironmentFile):
#   - systemd does NOT expand $HOME or ~  -> use absolute paths only
#   - double-quote values containing spaces
#   - '#' starts a comment; keep one VAR=value per line, no 'export'
#   - a var set to an EMPTY value is worse than absent (it overrides
#     defaults) -- leave optional vars commented out until you have a value

# --- data corpus (gate: reconcile + warehouse:verify; also the runner) ------
# Master Workbook (Spine A source). Synced by rclone-sync.sh / desktop push.
WORKBOOK_PATH="/home/YOURUSER/ora-data/eric-spreadsheets/Master Excel Template Company Wide -- Oxford.xlsx"
# Property P&L corpus dir, 32 .xlsx/.xlsm files (Spine B source).
FINANCIALS_DIR="/home/YOURUSER/ora-data/property-financials"
# Live warehouse SQLite (optional for the gate: warehouse:drift self-skips
# when absent; warehouse:verify always builds fresh in tmpdir).
WAREHOUSE_DB="/home/YOURUSER/oxford-command-center/data/warehouse/finance.sqlite"

# --- oxford-command-center server -------------------------------------------
# Port the local API server binds on 127.0.0.1 (never expose; SSH-tunnel in).
BRAIN_SERVER_PORT=8911

# --- Notion heartbeat (ora-heartbeat.service) -------------------------------
# Notion internal integration token (ntn_...). heartbeat.py strips whitespace,
# but paste it clean anyway (2026-06-11 InvalidHeader lesson).
NOTION_TOKEN="ntn_REPLACE_ME"
# Canonical heartbeat page under OpsHub -- probed BY ID by the GitHub
# watchdog; only change if the page is recreated (update the watchdog too).
HEARTBEAT_PAGE_ID="35c6ecd8-9e59-81d5-8d2c-d08002458b78"

# --- optional API keys -------------------------------------------------------
# Anthropic API key -- NOT needed if 'claude' uses subscription login on this
# box; uncomment only for API-key billing of headless sessions.
# ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
# FRED macro data key (Phase 1b agent tool + state unemployment enrichment).
# FRED_API_KEY="REPLACE_ME"

# --- git identity (optional) -------------------------------------------------
# Standard git env overrides, used by provision.sh prompts and by any unit
# that commits (vault backup). LEAVE COMMENTED unless set to non-empty
# values: an empty GIT_AUTHOR_NAME/EMAIL breaks 'git commit' entirely.
# GIT_AUTHOR_NAME="Gabriel Goldberg"
# GIT_AUTHOR_EMAIL="ggoldberg@oxfordra.net"

# --- rclone remote path overrides (optional) ---------------------------------
# Defaults inside rclone-sync.sh: 'onedrive-oxford:eric spreadsheets' and
# 'onedrive-oxford:Property Financials'. Override only if the OneDrive layout
# changes.
# ORA_ONEDRIVE_SPREADSHEETS="onedrive-oxford:eric spreadsheets"
# ORA_ONEDRIVE_FINANCIALS="onedrive-oxford:Property Financials"
