# ora-telemetry-rollup.service -- weekly EOS lane-compliance rollup
# (maintenance/eos-telemetry-rollup.py; always exits 0 by design -- this is
# a report, not a gate). EOS_TELEMETRY_DIR points the stdlib script at the
# server-side telemetry dir (its baked-in default is the Windows profile).
# Install: provision.sh copies this to ~/.config/systemd/user/.

[Unit]
Description=ORA EOS telemetry rollup (weekly report)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/ora/ora.env
Environment=EOS_TELEMETRY_DIR=%h/.claude/telemetry
ExecStart=/usr/bin/python3 %h/.claude/maintenance/eos-telemetry-rollup.py
