# ora-heartbeat.timer -- fires 06:00 and 18:00 LOCAL time.
# TIMEZONE: systemd user timers use the server's LOCAL timezone; the intended
# semantics are *-*-* 06,18:00 America/New_York. provision.sh sets the server
# TZ to America/New_York -- if this box is ever re-zoned, the heartbeat
# cadence drifts and the GitHub watchdog's 16h threshold stops being valid.
# Persistent=true: a beat missed while the box was down fires at next boot.

[Unit]
Description=ORA Notion heartbeat timer (06:00 + 18:00 local; local TZ must be America/New_York)

[Timer]
OnCalendar=06,18:00
Persistent=true

[Install]
WantedBy=timers.target
