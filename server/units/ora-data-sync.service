# ora-data-sync.service -- hourly one-way OneDrive -> server pull of the two
# data corpora (rclone-sync.sh). Exits 1 with printed instructions until the
# 'onedrive-oxford' rclone remote is configured (one-time device-code auth) --
# enable the timer only after a manual run succeeds.
# ora.env may override the remote paths (ORA_ONEDRIVE_SPREADSHEETS /
# ORA_ONEDRIVE_FINANCIALS).
# Install: provision.sh copies this to ~/.config/systemd/user/.

[Unit]
Description=ORA data corpus sync (OneDrive -> ~/ora-data, one-way)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/ora/ora.env
ExecStart=/usr/bin/bash %h/.claude/server/rclone-sync.sh
