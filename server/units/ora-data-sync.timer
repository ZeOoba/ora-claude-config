# ora-data-sync.timer -- hourly (minute 0). Keeps ~/ora-data current enough
# for the 02:30 full gate and any runner job. Persistent=true: a sync missed
# while the box was down runs at next boot.

[Unit]
Description=ORA data corpus sync timer (hourly)

[Timer]
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
