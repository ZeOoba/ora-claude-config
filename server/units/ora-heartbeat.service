# ora-heartbeat.service -- Notion heartbeat producer (moved here from the
# LAMS desktop task ora-cowork-heartbeat; the GitHub Actions watchdog in
# ZeOoba/ora-cowork-watchdog stays UNCHANGED as the off-box monitor).
# Needs NOTION_TOKEN (+ optional HEARTBEAT_PAGE_ID) from ora.env.
# A failed run leaves this unit in failed state AND, if beats keep missing,
# trips the watchdog's 16h alarm -- that asymmetry is intentional.
# Install: provision.sh copies this to ~/.config/systemd/user/.

[Unit]
Description=ORA Notion heartbeat producer (2x/day dead-man signal)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/ora/ora.env
ExecStart=/usr/bin/python3 %h/.claude/server/heartbeat.py
